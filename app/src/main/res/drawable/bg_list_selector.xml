<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado cuando ya está agregado a la lista (Checked: True) -->
    <item android:state_checked="true" android:drawable="@android:drawable/checkbox_on_background" />

    <!-- Estado por defecto para añadir a la lista (Checked: False) -->
    <item android:state_checked="false" android:drawable="@android:drawable/ic_input_add" />
</selector>