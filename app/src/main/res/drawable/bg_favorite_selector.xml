<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cuando está marcado (favorito) muestra el corazón lleno -->
    <item android:state_checked="true" android:drawable="@drawable/ic_heart_filled" />
    <!-- Cuando NO está marcado muestra el corazón vacio -->
    <item android:state_checked="false" android:drawable="@drawable/ic_heart_empty" />
</selector>